{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://helloworld.valdir.dev.br/schemas/language-entry.schema.json",
  "title": "LanguageEntry",
  "description": "The parsed shape a content/languages/<slug>.md file (see language-template.md) must produce at build time before it can be rendered on the site.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "helloWorld",
    "conditional",
    "calculation",
    "loop",
    "function",
    "stringConcatenation",
    "list",
    "boolean",
    "variables"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Derived from the source filename, e.g. java.md -> \"java\". Must be unique across all language entries."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name from the file's frontmatter, e.g. \"Java\"."
    },
    "helloWorld": { "$ref": "#/$defs/codeSample" },
    "conditional": { "$ref": "#/$defs/codeSample" },
    "calculation": { "$ref": "#/$defs/fixedOutcomeSample-4" },
    "loop": { "$ref": "#/$defs/fixedOutcomeSample-loop" },
    "function": { "$ref": "#/$defs/fixedOutcomeSample-5" },
    "stringConcatenation": { "$ref": "#/$defs/fixedOutcomeSample-greeting" },
    "list": { "$ref": "#/$defs/fixedOutcomeSample-6" },
    "boolean": { "$ref": "#/$defs/fixedOutcomeSample-true" },
    "variables": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/variableSample" },
      "allOf": [
        {
          "contains": { "properties": { "kind": { "const": "integer" } } }
        },
        {
          "contains": { "properties": { "kind": { "const": "string" } } }
        },
        {
          "contains": { "properties": { "kind": { "const": "float" } } }
        }
      ],
      "description": "MUST include at least one entry each of kind integer, string, and float. The string entry MUST declare the fixed name \"Mary\" (spec FR-011)."
    }
  },
  "$defs": {
    "codeSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Raw source snippet, whitespace preserved."
        },
        "result": {
          "type": "string",
          "description": "Present on every fixed-outcome sample (calculation, loop, function, stringConcatenation, list, boolean); the declared, build-validated outcome."
        }
      }
    },
    "fixedOutcomeSample-4": {
      "allOf": [
        { "$ref": "#/$defs/codeSample" },
        {
          "type": "object",
          "required": ["result"],
          "properties": {
            "result": {
              "const": "4",
              "description": "Every language entry's calculation MUST evaluate the fixed equation (1 + 1) * 2 and report this same result, so results are directly comparable across languages (spec FR-007)."
            }
          }
        }
      ]
    },
    "fixedOutcomeSample-loop": {
      "allOf": [
        { "$ref": "#/$defs/codeSample" },
        {
          "type": "object",
          "required": ["result"],
          "properties": {
            "result": {
              "const": "1 2 3 4 5",
              "description": "Every language entry's loop MUST count from 1 to 5 and report this same declared outcome (spec FR-009)."
            }
          }
        }
      ]
    },
    "fixedOutcomeSample-5": {
      "allOf": [
        { "$ref": "#/$defs/codeSample" },
        {
          "type": "object",
          "required": ["result"],
          "properties": {
            "result": {
              "const": "5",
              "description": "Every language entry's function example MUST add the fixed arguments 2 and 3 and report this same declared outcome (spec FR-010)."
            }
          }
        }
      ]
    },
    "fixedOutcomeSample-greeting": {
      "allOf": [
        { "$ref": "#/$defs/codeSample" },
        {
          "type": "object",
          "required": ["result"],
          "properties": {
            "result": {
              "const": "Olá, Mary",
              "description": "Every language entry's string concatenation MUST join a fixed greeting with the fixed name \"Mary\" and report this same declared outcome (spec FR-011)."
            }
          }
        }
      ]
    },
    "fixedOutcomeSample-6": {
      "allOf": [
        { "$ref": "#/$defs/codeSample" },
        {
          "type": "object",
          "required": ["result"],
          "properties": {
            "result": {
              "const": "6",
              "description": "Every language entry's list/array example MUST declare [1, 2, 3] and sum its elements to this same declared outcome (spec FR-012)."
            }
          }
        }
      ]
    },
    "fixedOutcomeSample-true": {
      "allOf": [
        { "$ref": "#/$defs/codeSample" },
        {
          "type": "object",
          "required": ["result"],
          "properties": {
            "result": {
              "const": "true",
              "description": "Every language entry's boolean comparison MUST evaluate the fixed comparison (18 >= 18) and declare this same outcome, regardless of how that language natively prints a boolean (spec FR-013)."
            }
          }
        }
      ]
    },
    "variableSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["integer", "string", "float"]
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
